# ==============================================================================
# MedFlow — Environment Configuration Template
# ==============================================================================

# Application & Runtime
PROJECT_NAME="MedFlow — Hospital Operations Digital Twin"
VERSION="1.0.0"
ENVIRONMENT="production"       # "development" | "production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Default: Zero-config SQLite.
# For production PostgreSQL: postgresql://username:password@hostname:5432/medflow
DATABASE_URL="sqlite:///./medflow.db"

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://medflow-dashboard.onrender.com"

# Simulation Bounds & Memory Safeguards (prevent free-tier 512MB RAM exhaustion)
MAX_SIMULATION_HOURS=168
DEFAULT_SIMULATION_HOURS=48
MAX_MONTE_CARLO_REPLICATIONS=15
DEFAULT_MONTE_CARLO_REPLICATIONS=5
DEFAULT_RANDOM_SEED=42

# CP-SAT Optimizer Parameters
OPTIMIZER_TIME_LIMIT_SECONDS=15

# Operational Cost Assumptions ($/hr)
HOURLY_COST_PHYSICIAN=180.0
HOURLY_COST_NURSE=65.0
HOURLY_COST_TECH=40.0
HOURLY_COST_BED=25.0

# Frontend Build Parameter (Embedded in client build via Vite)
# VITE_API_URL="https://medflow-api.onrender.com"
